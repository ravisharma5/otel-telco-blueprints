{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otel-telco-blueprints.invalid/schemas/serving-setups.schema.json",
  "title": "Serving setup profiles",
  "description": "Hardware setup profiles for the explorer, in the shape of an inference-playbooks hardware profile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["default", "fit_bands", "setups"],
  "properties": {
    "default": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup", "batch"],
      "properties": {
        "setup": { "type": "string" },
        "batch": { "type": "string", "enum": ["yes", "no"] }
      }
    },
    "fit_bands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fits_max_pct", "tight_max_pct", "why"],
      "properties": {
        "fits_max_pct": { "type": "integer", "minimum": 1, "maximum": 100 },
        "tight_max_pct": { "type": "integer", "minimum": 1, "maximum": 100 },
        "why": { "type": "string", "minLength": 1 }
      }
    },
    "setups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/setup" }
    }
  },
  "$defs": {
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "tier", "accelerators", "host", "engine_image", "ampere_note"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "tier": { "type": "string", "enum": ["regional", "core"] },
        "accelerators": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vendor", "model_class", "count_per_node", "memory_per_gpu_gb", "arch", "intra_node_interconnect"],
          "properties": {
            "vendor": { "type": "string", "enum": ["nvidia", "amd"] },
            "model_class": { "type": "string", "minLength": 1 },
            "count_per_node": { "type": "integer", "minimum": 1 },
            "memory_per_gpu_gb": { "type": "number", "exclusiveMinimum": 0 },
            "arch": { "type": "string", "enum": ["ada", "hopper", "blackwell", "cdna3"] },
            "intra_node_interconnect": { "type": "string", "enum": ["none", "pcie", "nvlink", "infinity-fabric"] }
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu_architecture"],
          "properties": {
            "cpu_architecture": { "type": "string", "enum": ["x86_64", "aarch64"] }
          }
        },
        "engine_image": {
          "type": "string",
          "enum": ["registry.redhat.io/rhaii/vllm-cuda-rhel9", "registry.redhat.io/rhaii/vllm-rocm-rhel9"]
        },
        "ampere_note": { "type": "boolean" }
      }
    }
  }
}
