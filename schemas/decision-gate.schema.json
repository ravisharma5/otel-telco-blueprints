{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otel-telco-blueprints.invalid/schemas/decision-gate.schema.json",
  "title": "Decision gate messages: action request and gate decision",
  "description": "An agent sends an action request. The orchestrator runs the gate and returns a gate decision. Thresholds are operator-set and referenced by policy_version, never carried in a message.",
  "oneOf": [
    { "$ref": "#/$defs/action_request" },
    { "$ref": "#/$defs/gate_decision" }
  ],
  "$defs": {
    "label": {
      "description": "Gate label. LOOK < NOTIFY < REVIEW < ACT is the autonomy order; STOP halts the step and is always allowed.",
      "enum": ["LOOK", "NOTIFY", "REVIEW", "ACT", "STOP"]
    },
    "risk_class": {
      "description": "Risk of the proposed step. This recipe uses four classes; operators may map their own.",
      "enum": ["read", "notify", "write_low", "write_high"]
    },
    "id": {
      "description": "ASCII identifier. The newline guard keeps validators that let $ match before a final newline from accepting one.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "not": { "pattern": "\\n" }
    },
    "timestamp": {
      "description": "RFC 3339 timestamp with a Z or numeric offset, ASCII digits only, and each field in range. The newline guard works as on id.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
      "not": { "pattern": "\\n" }
    },
    "probabilities": {
      "description": "Model probability per label. Consumers check that the values sum to 1 within a small tolerance.",
      "type": "object",
      "additionalProperties": false,
      "required": ["LOOK", "NOTIFY", "REVIEW", "ACT", "STOP"],
      "properties": {
        "LOOK": { "type": "number", "minimum": 0, "maximum": 1 },
        "NOTIFY": { "type": "number", "minimum": 0, "maximum": 1 },
        "REVIEW": { "type": "number", "minimum": 0, "maximum": 1 },
        "ACT": { "type": "number", "minimum": 0, "maximum": 1 },
        "STOP": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "action_request": {
      "description": "A step an agent proposes. Built by a model, so the orchestrator treats it as untrusted.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "request_id",
        "correlation_id",
        "submitted_at",
        "agent_identity",
        "capability",
        "risk_class",
        "proposed_step",
        "evidence_bundle",
        "state_changing"
      ],
      "properties": {
        "kind": { "const": "action_request" },
        "schema_version": { "const": "1" },
        "request_id": { "$ref": "#/$defs/id" },
        "correlation_id": { "$ref": "#/$defs/id" },
        "submitted_at": { "$ref": "#/$defs/timestamp" },
        "agent_identity": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "risk_class": { "$ref": "#/$defs/risk_class" },
        "proposed_step": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary"],
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "parameters": {
              "type": "object",
              "description": "Job inputs for the playbook. Open by design; the action layer checks them against the playbook before it runs."
            }
          }
        },
        "evidence_bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed", "conclusion_strength"],
          "properties": {
            "observed": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "conclusion_strength": { "enum": ["proven", "correlated", "hypothesis"] },
            "blast_radius": {
              "type": "object",
              "description": "Opaque context for the gate model and the human reviewer. No consumer branches on its keys."
            },
            "existing_ticket": { "type": ["string", "null"] },
            "recent_change": {
              "type": ["object", "null"],
              "description": "Opaque context for the gate model and the human reviewer. No consumer branches on its keys."
            }
          }
        },
        "state_changing": { "type": "boolean" },
        "playbook_id": { "type": ["string", "null"] },
        "advisory_label": {
          "$ref": "#/$defs/label",
          "description": "The agent's own pre-check, for logs only. The orchestrator re-runs the gate and never trusts this label."
        }
      }
    },
    "gate_decision": {
      "description": "The orchestrator's ruling on one action request.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "decision_id",
        "request_id",
        "correlation_id",
        "decided_at",
        "model_label",
        "label_probabilities",
        "policy_ceiling",
        "outcome",
        "policy_version",
        "model_revision",
        "required_approver"
      ],
      "properties": {
        "kind": { "const": "gate_decision" },
        "schema_version": { "const": "1" },
        "decision_id": { "$ref": "#/$defs/id" },
        "request_id": { "$ref": "#/$defs/id" },
        "correlation_id": { "$ref": "#/$defs/id" },
        "decided_at": { "$ref": "#/$defs/timestamp" },
        "model_label": {
          "$ref": "#/$defs/label",
          "description": "The label the gate model chose."
        },
        "label_probabilities": { "$ref": "#/$defs/probabilities" },
        "policy_ceiling": {
          "$ref": "#/$defs/label",
          "description": "Highest outcome the operator policy allows for this capability and risk class. A STOP ceiling allows only a STOP outcome."
        },
        "outcome": {
          "$ref": "#/$defs/label",
          "description": "Final ruling after applying the policy to the model label. Never above the policy ceiling, except STOP."
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "description": "Version of the operator policy that holds the thresholds and ceilings."
        },
        "model_revision": {
          "type": "string",
          "minLength": 1,
          "description": "Pinned revision of the gate model."
        },
        "required_approver": {
          "type": ["string", "null"],
          "description": "Role that must approve the step, never a named person. Required when the outcome is REVIEW."
        },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "REVIEW" } } },
          "then": { "properties": { "required_approver": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "policy_ceiling": { "const": "LOOK" } } },
          "then": { "properties": { "outcome": { "enum": ["LOOK", "STOP"] } } }
        },
        {
          "if": { "properties": { "policy_ceiling": { "const": "NOTIFY" } } },
          "then": { "properties": { "outcome": { "enum": ["LOOK", "NOTIFY", "STOP"] } } }
        },
        {
          "if": { "properties": { "policy_ceiling": { "const": "REVIEW" } } },
          "then": { "properties": { "outcome": { "enum": ["LOOK", "NOTIFY", "REVIEW", "STOP"] } } }
        },
        {
          "if": { "properties": { "policy_ceiling": { "const": "STOP" } } },
          "then": { "properties": { "outcome": { "const": "STOP" } } }
        }
      ]
    }
  }
}
