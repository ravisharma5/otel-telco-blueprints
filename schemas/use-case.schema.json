{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otel-telco-blueprints.invalid/schemas/use-case.schema.json",
  "title": "Use-case blueprint front matter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "doc_status",
    "domain",
    "flagship",
    "otel_slots",
    "autonomy_ceiling",
    "placement_tier",
    "one_liner",
    "platform_blueprints",
    "agent_school"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^UC-[A-Z]+-[0-9]{2}$" },
    "type": { "const": "use-case" },
    "title": { "type": "string", "minLength": 1 },
    "doc_status": { "$ref": "common.schema.json#/$defs/doc_status" },
    "domain": {
      "description": "demo is reserved for fictional fixtures.",
      "type": "string",
      "enum": [
        "standards-knowledge",
        "network-software",
        "network-operations",
        "agentic-operations",
        "business-assurance",
        "security",
        "research",
        "demo"
      ]
    },
    "flagship": { "type": "boolean" },
    "otel_slots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/otel_slot" }
    },
    "autonomy_ceiling": { "$ref": "common.schema.json#/$defs/autonomy_ceiling" },
    "tmf_an_level_target": {
      "description": "A target, never a claim.",
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "placement_tier": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/placement_tier" }
    },
    "one_liner": { "type": "string", "minLength": 10 },
    "platform_blueprints": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^PB-[0-9]{2}$" }
    },
    "agent_school": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/agent_school_course" }
    },
    "clarity_reviewed": { "$ref": "common.schema.json#/$defs/date" },
    "source": {
      "type": "array",
      "items": { "type": "string" }
    },
    "card": {
      "description": "Director-facing summary for the explorer home page, written by the recipe author. Patterns enforce the word limits.",
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "summary", "outcome", "audience", "measures", "risk"],
      "properties": {
        "goal": { "description": "8 words or fewer.", "type": "string", "pattern": "^\\s*\\S+(?:\\s+\\S+){0,7}\\s*$" },
        "summary": { "description": "25 words or fewer.", "type": "string", "pattern": "^\\s*\\S+(?:\\s+\\S+){0,24}\\s*$" },
        "outcome": { "description": "20 words or fewer.", "type": "string", "pattern": "^\\s*\\S+(?:\\s+\\S+){0,19}\\s*$" },
        "audience": { "description": "12 words or fewer.", "type": "string", "pattern": "^\\s*\\S+(?:\\s+\\S+){0,11}\\s*$" },
        "measures": {
          "description": "One to three measures, each 6 words or fewer.",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\s*\\S+(?:\\s+\\S+){0,5}\\s*$" }
        },
        "risk": { "description": "15 words or fewer.", "type": "string", "pattern": "^\\s*\\S+(?:\\s+\\S+){0,14}\\s*$" }
      }
    },
    "placement": {
      "description": "Slot roles that run at each tier. bplint checks the map against otel_slots and placement_tier.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "propertyNames": { "$ref": "common.schema.json#/$defs/placement_tier" },
      "patternProperties": {
        "^(far-edge|regional|core)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runs", "note"],
          "properties": {
            "runs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "common.schema.json#/$defs/slot_role" }
            },
            "note": {
              "description": "15 words or fewer; bplint requires one when runs is empty.",
              "type": "string",
              "pattern": "^\\s*(?:\\S+(?:\\s+\\S+){0,14})?\\s*$"
            }
          }
        }
      }
    }
  }
}
