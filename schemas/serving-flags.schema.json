{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otel-telco-blueprints.invalid/schemas/serving-flags.schema.json",
  "title": "Serving flags per slot and settings per setup",
  "description": "Source of truth for the serving page key flags fence. Each flag carries a one-sentence why; render hints keep the fence byte-identical.",
  "type": "object",
  "additionalProperties": false,
  "required": ["per_slot", "per_setup"],
  "properties": {
    "per_slot": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    },
    "per_setup": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/setup_setting" }
    }
  },
  "$defs": {
    "setup_setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup", "setting", "value", "why", "when_batch", "source"],
      "properties": {
        "setup": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "setting": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "when_batch": {
          "description": "yes: applies only when batch work shares the pool; no: applies only without batch work; null: applies either way.",
          "anyOf": [
            { "type": "string", "enum": ["yes", "no"] },
            { "type": "null" }
          ]
        },
        "source": { "type": "string", "pattern": "^https://" }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "comment", "roles", "lines"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "comment": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "serving-slot-variants.schema.json#/$defs/role" }
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/line" }
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args", "continue", "trailing_comment", "pad_to"],
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/arg" }
        },
        "continue": { "type": "boolean" },
        "trailing_comment": { "type": ["string", "null"] },
        "pad_to": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "arg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flag", "value", "why"],
      "properties": {
        "flag": { "type": "string", "pattern": "^--[a-z0-9][a-z0-9-]*$" },
        "value": { "type": ["string", "null"] },
        "why": { "type": "string", "minLength": 1 }
      }
    }
  }
}
