---
// Left rail: at a glance (domain, title, stage), your setup, on this page, and the recipe button.
import StageChip from './StageChip.astro';
import SetupForm from './SetupForm.astro';
import SectionNav from './SectionNav.astro';
import { frontmatter as copy } from '../content/copy.md';
import type { UseCase } from '../lib/data';

interface Props {
  useCase: UseCase;
}

const { useCase } = Astro.props;
const rail = copy.use_case.rail;
---
<aside class="rail" aria-label={rail.label}>
  <div class="box glance">
    <p class="box-heading">{rail.headings.glance}</p>
    <p class="eyebrow">{useCase.domain_label}</p>
    <p class="rail-title">{useCase.title}</p>
    <StageChip stage={useCase.stage} />
  </div>
  <div class="box setup">
    <p class="box-heading">{rail.headings.setup}</p>
    <SetupForm useCase={useCase} />
  </div>
  <div class="box nav-box">
    <p class="box-heading">{rail.headings.nav}</p>
    <SectionNav />
  </div>
  <a class="primary-button rail-button" href={import.meta.env.BASE_URL + useCase.recipe_url}>
    {copy.buttons.open_recipe} <span aria-hidden="true">→</span>
  </a>
</aside>

<style>
  .rail {
    position: sticky; top: var(--sticky-offset);
    max-height: calc(100vh - var(--sticky-offset) - var(--space-md)); overflow-y: auto;
    display: flex; flex-direction: column; gap: var(--space-md);
    padding: 2px; /* room for focus rings inside the scroll box */
  }
  .box {
    padding: var(--space-md); border-radius: var(--radius-lg);
    background: var(--color-surface); border: 1px solid var(--color-border);
    display: flex; flex-direction: column; gap: var(--space-sm); align-items: flex-start;
  }
  .box > :global(*) { max-width: 100%; }
  .setup, .nav-box { align-items: stretch; }
  .box p { margin: 0; }
  .box-heading {
    font-family: var(--font-display); font-weight: var(--weight-bold);
    font-size: var(--text-body); line-height: var(--leading-body);
  }
  .eyebrow {
    color: var(--color-text-muted); font-size: var(--text-label);
    font-weight: var(--weight-bold); line-height: var(--leading-label);
  }
  .rail-title { font-family: var(--font-display); font-weight: var(--weight-bold); }
  .rail-button { width: 100%; justify-content: center; }
  @media (max-width: 1023px) {
    .rail {
      position: static; max-height: none; overflow: visible;
      display: grid; grid-template-columns: 1fr 1fr; align-items: start;
    }
    /* Keep DOM order so Tab order matches what is on screen. */
    .nav-box, .rail-button { grid-column: 1 / -1; }
  }
  @media (max-width: 639px) {
    .rail { grid-template-columns: 1fr; }
  }
</style>
