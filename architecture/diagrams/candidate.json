  "cards": [
    {
      "dot": "cyan",
      "title": "Three routing layers",
      "items": [
        "Models-as-a-Service decides who may call which model",
        "The Decision slot picks the slot and the LLM size",
        "The llm-d scheduler picks the replica"
      ]
    },
    {
      "dot": "rose",
      "title": "Action path",
      "items": [
        "The agent reads and notifies through the tool gateway",
        "Only Ansible Automation Platform holds write credentials",
        "REVIEW waits for a human; LOOK and STOP block the step",
        "Every step is verified, rolled back on failure, and audited"
      ]
    },
    {
      "dot": "emerald",
      "title": "Lifecycle and placement",
      "items": [
        "EvalHub gates every promotion of a pinned revision",
        "GitOps and Advanced Cluster Management deploy to every tier",
        "Any component can be replaced"
      ]
    }
  ]
