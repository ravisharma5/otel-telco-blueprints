  "cards": [
    {
      "dot": "cyan",
      "title": "Three routing layers",
      "items": [
        "The AI Gateway decides who may call which model",
        "The Decision slot picks the slot and the LLM size",
        "The inference scheduler picks the replica"
      ]
    },
    {
      "dot": "rose",
      "title": "Action path",
      "items": [
        "The agent reads and notifies through the MCP Gateway",
        "Only the execute step holds write credentials",
        "REVIEW waits for a human; LOOK and STOP block the step",
        "Every step is verified, rolled back on failure, and audited"
      ]
    },
    {
      "dot": "emerald",
      "title": "Lifecycle and placement",
      "items": [
        "Evaluation gates every promotion of a pinned revision",
        "Declarative deployment and fleet management reach every tier",
        "Any component can be replaced"
      ]
    }
  ]
